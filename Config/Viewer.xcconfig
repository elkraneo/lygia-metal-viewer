// The demo shaders include LYGIA from the Lygia package's resource bundle. The
// bundle layout differs per platform (see External/lygia/swift/README.md).
LYGIA_BUNDLE_HEADERS[sdk=macosx*] = $(BUILT_PRODUCTS_DIR)/Lygia_Lygia.bundle/Contents/Resources
LYGIA_BUNDLE_HEADERS = $(BUILT_PRODUCTS_DIR)/Lygia_Lygia.bundle

// Optional folder that contains `lygia/`, searched before the bundle. Empty by
// default; Config/Local.xcconfig can point it at another checkout.
LYGIA_SOURCE_ROOT =

// Folder where the build exports upstream LYGIA main (git-ignored), for the Compare view.
LYGIA_UPSTREAM_ROOT = $(SRCROOT)/External/upstream

// Ad-hoc "Sign to Run Locally", so macOS and simulator builds need no team.
VIEWER_CODE_SIGN_STYLE = Manual
VIEWER_CODE_SIGN_IDENTITY = -
VIEWER_DEVELOPMENT_TEAM =

// Local overrides (git-ignored), e.g. to build against another LYGIA checkout
// or to sign for a device:
//   LYGIA_SOURCE_ROOT = $(SRCROOT)/../source
//   VIEWER_CODE_SIGN_STYLE = Automatic
//   VIEWER_CODE_SIGN_IDENTITY = Apple Development
//   VIEWER_DEVELOPMENT_TEAM = <your team ID>
#include? "Local.xcconfig"
